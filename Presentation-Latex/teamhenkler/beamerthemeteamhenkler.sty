% compact reference list: small font, tight spacing, fills each slide
\newcommand{\makebib}[2][References]{%
  \begingroup
    \setbeamertemplate{frametitle continuation}{}% Remove Roman numerals
    \setbeamerfont{bibliography item}{size=\scriptsize}%
    \setbeamerfont{bibliography entry author}{size=\scriptsize}%
    \setbeamerfont{bibliography entry title}{size=\scriptsize}%
    \setbeamerfont{bibliography entry location}{size=\scriptsize}%
    \setbeamerfont{bibliography entry note}{size=\scriptsize}%
    \begin{frame}[plain, noframenumbering, allowframebreaks=1, t]{#1}
      \scriptsize
      \setlength{\parskip}{0pt}%
      \bibliographystyle{ieeetr}
      \bibliography{#2}
    \end{frame}
  \endgroup
}

\newcommand{\maketoc}[1][Table of Contents]{  % Default value: "Table of Contents"
    \begin{frame}[plain,noframenumbering]{#1}
        \tableofcontents
    \end{frame}
}

