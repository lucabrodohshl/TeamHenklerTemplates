    },
    % FH Dortmund
    FhD/.code={
        \titlegraphic{\includegraphics[height=8mm]{teamhenkler-logo-fhdortmund.png}}
        \institute{}
    },
    % conference talks: HSHL, AKI4KMU and funding logos (NRW ministry, EU)
    conference/.code={
        \titlegraphic{%
          \makebox[\textwidth][c]{%
            \includegraphics[height=1cm]{teamhenkler-logo-hshl.png}%
            \hspace{0.3cm}%
            \includegraphics[height=1cm]{teamhenkler-logo-aki4kmu.jpg}%
            \hspace{0.3cm}%
            \includegraphics[height=0.5cm]{teamhenkler-logo-mwike-nrw.png}%
            \hspace{0.3cm}%
            \includegraphics[height=0.5cm]{teamhenkler-logo-eu.png}%
          }%
        }
        \institute{}
    },
    % no logos at all
    none/.code={
        \titlegraphic{}
        \institute{}
    }
}

\newcommand{\teamhenkler@setdefaults}{
